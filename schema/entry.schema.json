{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cc-router 社区目录条目 (plugins/<type>/<id>.json)",
  "description": "文件名就是插件 id, 必须与作者仓库 cc-router-plugin.json 里的 id 一致; 所在目录就是插件类型。名字、介绍、版本都从作者的清单里读, 这里不用重复写。",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo", "versions"],
  "properties": {
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$", "description": "GitHub 公开仓库 owner/repo" },
    "path": { "type": "string", "description": "清单所在的子目录 (一个仓库放多个插件时用)" },
    "tags": { "type": "array", "maxItems": 5, "items": { "type": "string" }, "description": "见 schema/tags.json" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "description": "按时间顺序追加; 最后一项是当前版本。发新版 = 在末尾加一个提交号。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commit"],
        "properties": { "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
      }
    },
    "revoked": { "type": "string", "description": "下架原因。写了之后 app 会提示已安装的用户。" }
  }
}
